E04F000F // 00: SUB  R0, R15, R15   ; R0 = 0
E2802005 // 04: ADD  R2, R0, #5     ; R2 = 5
E280300C // 08: ADD  R3, R0, #12    ; R3 = 12
E2437009 // 0C: SUB  R7, R3, #9     ; R7 = 3
E1874002 // 10: ORR  R4, R7, R2     ; R4 = 3 OR 5 = 7
E0035004 // 14: AND  R5, R3, R4     ; R5 = 12 AND 7 = 4
E0855004 // 18: ADD  R5, R5, R4     ; R5 = 4 + 7 = 11
E0558007 // 1C: SUBS R8, R5, R7     ; R8 = 8, cap nhat co
0A00000C // 20: BEQ  END            ; khong nhay (Z = 0)
E0538004 // 24: SUBS R8, R3, R4     ; R8 = 5
AA000000 // 28: BGE  AROUND         ; nhay (N = V = 0)
E2805000 // 2C: ADD  R5, R0, #0     ; bi bo qua
E0578002 // 30: AROUND: SUBS R8, R7, R2 ; R8 = -2, N = 1
B2857001 // 34: ADDLT R7, R5, #1    ; thuc thi vi LT: R7 = 12
E0477002 // 38: SUB  R7, R7, R2     ; R7 = 12 - 5 = 7
E5837054 // 3C: STR  R7, [R3, #84]  ; mem[96] = 7
E5902060 // 40: LDR  R2, [R0, #96]  ; R2 = mem[96] = 7
E08FF000 // 44: ADD  R15, R15, R0   ; PC = PC + 8, bo qua lenh ke tiep
E280200E // 48: ADD  R2, R0, #14    ; khong duoc chay
EA000001 // 4C: B    END            ; nhay
E280200D // 50: ADD  R2, R0, #13    ; khong duoc chay
E280200A // 54: ADD  R2, R0, #10    ; khong duoc chay
E5802064 // 58: END: STR R2, [R0, #100] ; mem[100] = 7
